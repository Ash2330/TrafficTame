# ============================================================
# Traffic Congestion Prediction — .gitignore
# ============================================================

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Python caches ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb~

# --- Large data files (raw dataset) ---
data/raw/*.csv
data/raw/*.zip
data/raw/*.gz

# --- Large model binaries (optional — keep if you want models in git) ---
# models/*.joblib

# --- Processed data (regeneratable) ---
data/processed/*.parquet
data/processed/*.csv

# --- Logs and temp files ---
*.log
streamlit_stdout.log
streamlit_stderr.log

# --- OS artifacts ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE config ---
.vscode/
.idea/
*.code-workspace

# --- Secrets / credentials ---
.env
*.pem
*.key

# --- Docs build outputs ---
site/
